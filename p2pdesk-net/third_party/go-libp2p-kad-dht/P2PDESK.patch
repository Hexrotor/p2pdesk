+// RoutingTableCheckConcurrency bounds stale-peer liveness checks, including
+// their connection attempts. Waiting for a worker does not consume the peer's
+// network timeout. Zero (the default) preserves upstream's unbounded behavior.
+func RoutingTableCheckConcurrency(n int) Option {
+	return func(c *dhtcfg.Config) error {
+		if n < 1 {
+			return fmt.Errorf("routing table check concurrency must be positive")
+		}
+		c.RoutingTable.CheckConcurrency = n
+		return nil
+	}
+}
+
+// RoutingTableRefreshWithoutFollowup ends background bucket lookups at normal
+// alpha/beta convergence. The additional top-K followup used by GetClosestPeers
+// to prepare publication connections is unnecessary for routing maintenance.
+// Public routing API calls, including FindPeer/Provide, are unchanged.
+func RoutingTableRefreshWithoutFollowup() Option {
+	return func(c *dhtcfg.Config) error {
+		c.RoutingTable.RefreshWithoutFollowup = true
+		return nil
+	}
+}
