+// refreshLookup is only used for endpoint background maintenance. Keep the
+// standard convergence rule and in-query peer/RT updates, without establishing
+// all top-K publication connections after the lookup has already converged.
+func (dht *IpfsDHT) refreshLookup(ctx context.Context, key string) error {
+	res, _, err := dht.runQuery(ctx, key, dht.pmGetClosestPeers(key), func(*qpeerset.QueryPeerset) bool { return false }, true)
+	if err != nil {
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if !res.completed || len(res.peers) == 0 {
+		return ErrNoPeersQueried
+	}
+	dht.routingTable.ResetCplRefreshedAtForID(kb.ConvertKey(key), time.Now())
+	return nil
+}
