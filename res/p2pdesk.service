[Unit]
Description=P2PDesk
Requires=network.target
After=systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/bin/p2pdesk --service
# kill --tray and --server both
ExecStop=pkill -f "p2pdesk --"
# below two lines do not work, have to use above one line
#ExecStop=pkill -f "p2pdesk --tray"
#ExecStop=pkill -f "p2pdesk --server"
PIDFile=/run/p2pdesk.pid
KillMode=mixed
TimeoutStopSec=30
User=root
LimitNOFILE=100000
Environment="PULSE_LATENCY_MSEC=60" "PIPEWIRE_LATENCY=1024/48000"

[Install]
WantedBy=multi-user.target
